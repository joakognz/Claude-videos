        -60
      ],
      "notes": "Un mensaje por persona y reel",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.instagram.com/{{ $('⚙️ Ajustes').first().json.versionApi }}/{{ $json.reel }}",
