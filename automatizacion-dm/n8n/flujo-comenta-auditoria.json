    {
      "parameters": {
        "jsCode": "// 🔑 Meta comprueba que esta dirección es tuya antes de mandarte avisos.\n// Pon aquí la misma contraseña que escribas en Meta, en el campo «Verify token» de los webhooks.\nconst CONTRASENA_META = 'CAMBIA-ESTO-por-una-frase-larga';\n\nconst q = $input.first().json.query || {};\nconst ok = q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === CONTRASENA_META;\nreturn [{ json: { codigo: ok ? 200 : 403, respuesta: ok ? String(q['hub.challenge']) : 'contraseña incorrecta' } }];\n"
      },
      "id": "cbc603df-7169-5ca4-bc14-6331a5a38eed",
      "name": "🔑 Contraseña de Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -200
      ],
      "notes": "La contraseña («Verify token») de Meta",
